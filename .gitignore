# Local Frappe bench (rebuilt by ./dev init) and dev leftovers
development/frappe-bench/
development/backups/
development/scratch/
development/*.log

# VS Code: keep the shared config only
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json

# Deployed environment secrets and state (live on the host only)
deploy/env/*.env
!deploy/env/example.env
deploy/state/

__pycache__/
*.pyc
node_modules/
.claude/settings.local.json

# Built assets (bench build writes them into the app in dev)
apps/*/*/public/dist/
