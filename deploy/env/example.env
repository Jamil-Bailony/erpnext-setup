# Template for one deployed environment. On the host, copy to deploy/env/<env>.env
# (git-ignored), e.g. pi.env, server.env or local.env, and fill in. Never commit real values.

# Compose project name: names the containers (<project>-backend-1) and volumes.
# The existing Pi stack uses "erpnext"; keep that there so its volumes are reused.
COMPOSE_PROJECT=erpnext

# Site (Frappe site name). With noproxy, FRAPPE_SITE_NAME_HEADER pins every request to this
# site, so it can be opened by any hostname/IP (Netbird IP, raspberrypi.local, ...).
SITE_NAME=erp.local
FRAPPE_SITE_NAME_HEADER=erp.local

# The image is never set here: it is the ref given to deploy.sh, recorded in deploy/state/<env>.env.
# deploy.sh pulls it; compose never does (deploy/dc forces PULL_POLICY=never).

# Database root password: openssl rand -base64 24. Fixed once the database volume exists:
# for an existing stack, copy DB_PASSWORD from its old .env.
DB_PASSWORD=

# Extra compose files from deploy/, space-separated. Pi: compose.pi.yaml (memory tuning).
COMPOSE_OVERRIDES=compose.pi.yaml

# Proxy: noproxy  plain HTTP on HTTP_PUBLISH_PORT; for VPN/LAN-only use (the Pi).
#        https    Traefik + Let's Encrypt. Needs public DNS and ports 80/443 open.
#                 Set HTTP_PUBLISH_PORT=80, SITES_RULE, LETSENCRYPT_EMAIL.
PROXY=noproxy
HTTP_PUBLISH_PORT=8080
# HTTPS_PUBLISH_PORT=443
# Keep the single quotes: this file is sourced by bash and the backticks are for Traefik.
# SITES_RULE='Host(`erp.example.com`)'
# LETSENCRYPT_EMAIL=admin@example.com

# Host directory for deploy-time backups (database, files, site_config.json with the
# encryption key). Copy it off this host as well.
BACKUP_DIR=/mnt/backup/erp-deploy-backups
