# Release pins. Read by scripts/build-image.sh, deploy/deploy.sh and CI.
# To upgrade: bump these (and the tags in apps.json), build, deploy to a test env, then the Pi.

# Frappe framework git ref (release tag)
FRAPPE_REF=v16.52.0

# Image bases from frappe_docker (OS + Python + Node only). Pinned to multi-arch index
# digests, so the same pin works for arm64 (Pi) and amd64 (server).
BUILD_IMAGE=docker.io/frappe/build:version-16@sha256:f33cb81ca3b22f94db6bf293fd8269c84b481c6dc33190873e565b0d90da6c4b
BASE_IMAGE=docker.io/frappe/base:version-16@sha256:59c530f26fa60089d18458aa0b7852d5a63b0f01ec77c145343013f7b2679bef

# Our custom app, kept in this repo under apps/
CUSTOM_APP=erp_custom
